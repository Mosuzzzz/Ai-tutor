# --- Core ---
DATABASE_URL=sqlite:///./ai_tutor.db
JWT_SECRET_KEY=change-me-to-a-32+-byte-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated browser origins allowed by CORS.
FRONTEND_URL=http://localhost:3000

# --- AI (optional; offline fallbacks used when empty) ---
GROQ_API_KEY=

# --- Google OAuth (consumer social login) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be the Next.js BFF callback below:
#   <frontend-origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Must be the exact frontend origin and one of FRONTEND_URL.
OAUTH_SUCCESS_REDIRECT=http://localhost:3000
# Shared server-only credential. Set the same random value in the Next.js env.
BFF_SHARED_SECRET=change-me-to-a-long-random-secret
